{
  "name": "latent-model-organizer-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for Latent Model Organizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/erroralex/latent-model-organizer.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Latent Model Organizer",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "kill-port": "^2.0.1"
  },
  "build": {
    "appId": "com.latent.organizer",
    "productName": "Latent Model Organizer",
    "publish": {
      "provider": "github",
      "owner": "erroralex",
      "repo": "latent-model-organizer"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "extraFiles": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "../frontend/src/assets/lmo_icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "../frontend/src/assets/lmo_icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "../frontend/src/assets/lmo_icon.png",
      "identity": null
    }
  }
}