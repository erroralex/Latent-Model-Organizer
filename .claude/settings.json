{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(mvn test:*)",
      "Bash(mvn clean package:*)",
      "Bash(mvn compile:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm start:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  }
}
